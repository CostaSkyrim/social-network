            },
            "/commentapprove": {
                "rate_limit_count": 100,
                "rate_limit_second_interval": 20.0
            },
            "/votepost": {
                "rate_limit_count": 15,
                "rate_limit_second_interval": 20.0
            },
            "/updatebio": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 20.0
            },
            "/votecomment": {
                "rate_limit_count": 15,
                "rate_limit_second_interval": 20.0
            },
            "/postlist": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 20.0
            },
            "/commentlist": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 20.0
            },
            "/notificationlist": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 20.0
            },
            "/ws/notifications": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 20.0
            },
            "/notificationseen": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 20.0
            },
            "/addcategory": {
                "rate_limit_count": 100,
                "rate_limit_second_interval": 20.0
