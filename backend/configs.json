            },
            "/createpost": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 60.0
            },
            "/createcomment": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 20.0
            },
            "/postedit": {
