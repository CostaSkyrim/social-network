{
    "frontend": {
        "url": "http://localhost:3000"
    },
    "scheduler": {
        "enabled": true,
        "tick_interval": "1m",
        "reminder_lead": "30m"
    },
    "sessions": {
        "storage": "redis",
        "ttl": "24h"
    },
    "redis": {
        "addr": "localhost:6379",
        "password": "",
        "db": 0,
        "pool_size": 10,
        "min_idle_conns": 5,
        "max_retries": 3,
        "dial_timeout": "5s",
        "read_timeout": "3s",
        "write_timeout": "3s"
    },
    "database_configuration": {
        "path": [
            "backend",
            "db",
            "social-network.db"
        ],
        "wal": {
            "auto_truncate": true,
            "truncate_interval": "5m",
            "cache_size": "10000",
            "synchronous": "NORMAL"
        },
        "use_cache": true,
        "clean_up_sessions": "10m",
        "limits": {
            "rows_limit": 1000,
            "max_username": 25,
            "min_username": 4,
            "max_pass": 40,
            "min_pass": 7,
            "max_bio": 1000,
            "max_first_name": 30,
            "min_first_name": 1,
            "max_last_name": 30,
            "max_title": 300,
            "min_title": 5,
            "max_comment_body": 3000,
            "max_post_body": 7000,
            "min_body": 1,
            "max_description": 1000,
            "max_message_body": 4000,
            "max_group_title": 200
        },
        "system_images": {
            "default_pfp.jpg": {}
        }
    },
    "server": {
        "Addr": ":8080"
    },
    "handlers": {
        "image": {
            "max_size": "20MB",
            "file_types": [
                "image/jpeg",
                "image/png",
                "image/gif"
            ],
            "path_prefix": [
                "backend",
                "data",
                "images"
            ]
        },
        "rate_limits": {
            "universal": {
                "rate_limit_count": 40,
                "rate_limit_second_interval": 2.0
            },
            "/images/": {
                "rate_limit_count": 40,
                "rate_limit_second_interval": 20.0
            },
            "/api/auth/check": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 10.0
            },
            "/api/signup": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 30.0
            },
            "/api/login": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 30.0
            },
            "/api/logout": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 30.0
            },
            "/api/auth/": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 25.0
            },
            "/api/posts": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 60.0
            },
            "/api/comments": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 20.0
            },
            "/api/posts/{id}/edit": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 20.0
            },
            "/api/comments/{id}/edit": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 20.0
            },
            "/api/users/{id}/avatar": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 2000.0
            },
            "/api/events/": {
                "rate_limit_count": 15,
                "rate_limit_second_interval": 20.0
            },
            "/api/events/{id}/rsvp": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 20.0
            },
            "/api/chat/send": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 10.0
            }
        }
    },
    "oauth": {
        "google": {
            "client_id": "",
            "client_secret": "",
            "scopes": ["https://www.googleapis.com/auth/userinfo.email", "https://www.googleapis.com/auth/userinfo.profile"],
            "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
            "token_url": "https://oauth2.googleapis.com/token",
            "user_info_url": "https://www.googleapis.com/oauth2/v2/userinfo",
            "redirect_uri": "http://localhost:8080/api/auth/google/callback"
        },
        "github": {
            "client_id": "",
            "client_secret": "",
            "scopes": ["read:user", "user:email"],
            "auth_url": "https://github.com/login/oauth/authorize",
            "token_url": "https://github.com/login/oauth/access_token",
            "user_info_url": "https://api.github.com/user",
            "user_emails_url": "https://api.github.com/user/emails",
            "redirect_uri": "http://localhost:8080/api/auth/github/callback"
        }
    }
}
