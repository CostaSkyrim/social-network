{
    "frontend": {
        "url": "http://localhost:3000"
    },
    "redis": {
        "addr": "localhost:6379",
        "password": "",
        "db": 0,
        "pool_size": 10,
        "min_idle_conns": 5,
        "max_retries": 3,
        "dial_timeout": "5s",
        "read_timeout": "3s",
        "write_timeout": "3s"
    },
    "database_configuration": {
        "path": [
            "backend",
            "db",
            "social-network.db"
        ],
        "wal": {
            "auto_truncate": true,
            "truncate_interval": "5m",
            "cache_size": "10000",
            "synchronous": "NORMAL"
        },
        "use_cache": true,
        "cache_setup": {
            "users_cache_limit": 1000,
            "posts_cache_limit": 500,
            "categories_cache_limit": 100
        },
        "clean_up_sessions": "10m",
        "ranking_cfg": {
            "default_rank_score": 300.0,
            "like_score": 100.0,
            "dislike_score": 90.0,
            "time_penalty": 1.0,
            "halving_hour_interval": 5.0,
            "cutoff_time": "48h",
            "interval": "10m"
        },
        "limits": {
            "rows_limit": 1000,
            "max_username": 25,
            "min_username": 4,
            "max_pass": 40,
            "min_pass": 7,
            "max_bio": 1000,
            "max_first_name": 30,
            "max_last_name": 30,
            "max_title": 300,
            "min_title": 5,
            "max_comment_body": 3000,
            "max_post_body": 7000,
            "min_body": 1,
            "max_categories": 5
        },
        "system_images": {
            "default_pfp.jpg": {}
        }
    },
    "server": {
        "Addr": ":8080"
    },
    "certifications": {
        "use_https": true,
        "file": [
            "certs",
            "certs.pem"
        ],
        "key": [
            "certs",
            "key.pem"
        ]
    },
    "handlers": {
        "image": {
            "max_size": "20MB",
            "file_types": [
                "image/jpg",
                "image/png",
                "image/gif"
            ],
            "path_prefix": [
                "backend",
                "data",
                "images"
            ]
        },
        "max_post_size": "21MB",
        "cookie_expiration_hours": "24h",
        "rate_limits": {
            "/image/": {
                "rate_limit_count": 40,
                "rate_limit_second_interval": 20.0
            },
            "universal": {
                "rate_limit_count": 40,
                "rate_limit_second_interval": 2.0
            },
            "/": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 20.0
            },
            "/profile/": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 20.0
            },
            "/post/": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 20.0
            },
            "/postform": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 20.0
            },
            "/notificationfeed": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 20.0
            },
            "/removedposts": {
                "rate_limit_count": 100,
                "rate_limit_second_interval": 20.0
            },
            "/removedcomments": {
                "rate_limit_count": 100,
                "rate_limit_second_interval": 20.0
            },
            "/api/auth/check": {
                "rate_limit_count": 20,
                "rate_limit_second_interval": 10.0
            },
            "/login": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 30.0
            },
            "/logout": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 30.0
            },
            "/signup": {
                "rate_limit_count": 5,
                "rate_limit_second_interval": 30.0
            },
            "/auth/google": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 25.0
            },
            "/auth/google/callback": {
                "rate_limit_count": 10,
                "rate_limit_second_interval": 25.0
            },
