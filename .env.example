# Copy this file to .env and fill in real values. .env is gitignored.
#
# These override the OAuth fields in backend/configs.json and
# backend/configs.docker.json at load time. Never commit real credentials.
#
# Anyone can run OAuth with their OWN provider apps: create a Google/GitHub
# OAuth app, register the callback URL below, then paste the credentials here.
# See the "Enabling OAuth with your own app" section in README.md.

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Google OAuth client.
# Default (make dev): http://localhost:8080/api/auth/google/callback
# Docker (make docker-up): https://localhost/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# GitHub OAuth (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the Authorization callback URL in the GitHub OAuth app.
# Default (make dev): http://localhost:8080/api/auth/github/callback
# Docker (make docker-up): https://localhost/api/auth/github/callback
GITHUB_REDIRECT_URI=
