# Copy this file to .env and fill in real values. .env is gitignored.
#
# These override the (empty) OAuth fields in backend/configs.json and
# backend/configs.docker.json at load time. Never commit real credentials.

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
